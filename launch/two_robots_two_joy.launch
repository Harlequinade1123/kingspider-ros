<launch>
  <!-- Kingspider -->
  <node pkg="kingspider" type="kingspider_joy_node" name="kingspider_node_1" output="screen">
    <param name="joy_topic" value="/joy1"/>
    <param name="device_name" value="/dev/ttyUSB0"/>
    <param name="baudrate" value="57600"/>
  </node>

  <node pkg="kingspider" type="kingspider_joy_node" name="kingspider_node_2" output="screen">
    <param name="joy_topic" value="/joy2"/>
    <param name="device_name" value="/dev/ttyUSB1"/>
    <param name="baudrate" value="57600"/>
  </node>

  <!-- ジョイスティック -->
  <node pkg="joy" type="joy_node" name="joy_node_1" output="screen" respawn="true" respawn_delay="1">
    <param name="dev" value="/dev/input/js0"/>
    <param name="deadzone" value="0.05"/>
    <param name="autorepeat_rate" value="20"/>
    <remap from="joy" to="joy1"/>
  </node>

  <node pkg="joy" type="joy_node" name="joy_node_2" output="screen" respawn="true" respawn_delay="1">
    <param name="dev" value="/dev/input/js1"/>
    <param name="deadzone" value="0.05"/>
    <param name="autorepeat_rate" value="20"/>
    <remap from="joy" to="joy2"/>
  </node>
</launch>